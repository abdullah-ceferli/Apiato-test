    {
      "name": "WEB — CSRF, session + Password Grant, logout",
      "item": [
        {
          "name": "01 Login formu və CSRF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": "{{web_url}}/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const csrf = pm.response.text().match(/<meta name=\"csrf-token\" content=\"([^\"]+)\"/);",
                  "pm.test(\"CSRF token var\", () => pm.expect(csrf).not.to.eql(null));",
                  "if (csrf) pm.environment.set(\"csrf_token\", csrf[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Adi WEB POST login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": "{{web_url}}/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_token",
                  "value": "{{csrf_token}}",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{email_a}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 302\", () => pm.response.to.have.status(302));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "03 Qorunan Blade və access token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": "{{web_url}}/tasks",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const csrf = pm.response.text().match(/<meta name=\"csrf-token\" content=\"([^\"]+)\"/);",
                  "pm.test(\"CSRF token var\", () => pm.expect(csrf).not.to.eql(null));",
                  "if (csrf) pm.environment.set(\"csrf_token\", csrf[1]);",
                  "const jwt = pm.response.text().match(/eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+/);",
                  "pm.test(\"Blade-də access token var\", () => pm.expect(jwt).not.to.eql(null));",
                  "if (jwt) pm.environment.set(\"session_access_token\", jwt[0]);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 WEB login-dən alınan tokenlə API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/v1/tasks",
