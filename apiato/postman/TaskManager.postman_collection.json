{
  "info": {
    "name": "Şəxsi Task Manager — qəbul yoxlamaları",
    "description": "Əvvəl README quraşdırmasını və seeder-i işlədin. Lokal environment-də client_id və client_secret doldurun. Qovluqların hər birini sıra ilə işlədin; WEB sorğuları Postman cookie jar-dan istifadə edir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "API — Password Grant, CRUD, sahiblik, refresh, logout",
      "item": [
        {
          "name": "01 Tokensiz API — 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/v1/tasks",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Aysel Password Grant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/v1/oauth/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{email_a}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.environment.set(\"access_token\", data.access_token);",
                  "pm.environment.set(\"refresh_token\", data.refresh_token);",
                  "pm.test(\"Password Grant tokens\", () => {",
                  "    pm.expect(data.token_type).to.eql(\"Bearer\");",
                  "    pm.expect(data.access_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(data.refresh_token).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
